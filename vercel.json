{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w frontends",
  "outputDirectory": "frontends/dist",
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
