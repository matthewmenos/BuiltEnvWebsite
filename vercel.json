{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build -w frontends",
  "outputDirectory": "frontends/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
