{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://pubuiltenvironment.org",
          "https://*.vercel.app",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["PUT", "GET", "HEAD"],
        "headers": ["*"],
        "expose_headers": ["Content-Length", "ETag"]
      },
      "max_age_seconds": 86400
    }
  ]
}