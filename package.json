{
  "name": "builtenvwebsite",
  "version": "1.0.0",
  "private": true,
  "description": "Department of Built Environment - Full-stack website",
  "scripts": {
    "build": "npm run build -w frontends",
    "dev:frontends": "npm run dev -w frontends",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "vercel": "vercel",
    "deploy": "vercel --prod",
    "deploy:ci": "vercel --prod --yes"
  },
  "workspaces": [
    "frontends"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.12",
    "@vercel/node": "^22.0.0",
    "drizzle-kit": "^0.20.13"
  }
}
