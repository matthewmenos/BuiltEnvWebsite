# BuiltEnvWebsite environment template
# Copy to `.env` for your own local values (never commit real secrets).
# NOTE: serve.js reads PORT directly from process.env; the Worker vars are
# set on Cloudflare (see worker/wrangler.toml and R2_SETUP.md).

# --- Local dev server (serve.js) -------------------------------------------
# Port for `npm run dev` (default: 5173)
PORT=5173

# --- Admin sign-in (serve.js -> POST /api/admin) ---------------------------
# Admin credentials live ONLY here (or in the host's environment) - never in
# the site code or localStorage. The dashboard posts to /api/admin and gets a
# signed session token in return.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Random string used to sign session tokens (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Optional: session lifetime in hours (default 8)
ADMIN_SESSION_HOURS=8

# --- Cloudflare Worker / R2 media ------------------------------------------
# Worker deployment URL (from `wrangler deploy`), e.g.
#   https://builtenv-media.<account>.workers.dev
# When R2_UPLOAD + UPLOAD_TOKEN are set, the dashboard proxies uploads through
# PUT/DELETE /api/r2/<key> with the admin session - the R2 token never reaches
# the browser. Leave R2_UPLOAD empty to fall back to Admin -> Settings -> Media.
R2_UPLOAD=https://builtenv-media.YOUR_ACCOUNT.workers.dev

# Public base URL where uploaded objects are readable, e.g.
#   https://pub-xxxxxxxx.r2.dev   or   https://media.example.com
# Set in BOTH worker/wrangler.toml [vars] and here (used to build public URLs).
PUBLIC_BASE=https://YOUR_PUBLISHED_R2_URL

# Bearer token required by the Worker for PUT/DELETE uploads.
# Set in BOTH places:
#   npx wrangler secret put UPLOAD_TOKEN   (Worker)
#   and here                              (server-side proxy)
UPLOAD_TOKEN=replace-with-a-long-random-token
