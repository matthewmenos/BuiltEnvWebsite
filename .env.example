# =============================================================================
# BuiltEnvWebsite — environment template
# Local (Vercel CLI): copy to `.env.local` — `vercel dev` loads it automatically.
# Production: set the same variables in the Vercel dashboard
# (Project > Settings > Environment Variables).
# Never commit real secrets — `.env`, `.env.local`, `.env.production`
# and `.env.*.local` are git-ignored.
# =============================================================================

# --- Database (required by lib/db.ts, lib/env.ts) ---
# Neon Postgres connection string (pooled or direct).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Auth (required by lib/auth.ts, lib/env.ts) ---
# Long random secret used to sign admin JWTs (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime. Accepts jsonwebtoken values like "7d", "24h", "3600".
JWT_EXPIRES_IN=7d

# --- Cloudflare R2 object storage (REQUIRED — every uploaded media file) ---
# All images/uploads live in R2; the file registry lives in the bucket at
# meta/registry.json (see lib/r2.ts). Create an API token with Object Read &
# Write for the bucket: Cloudflare dashboard -> R2 -> Manage R2 API Tokens.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=builtenv-uploads
# Optional: S3-compatible endpoint override (local mocks / MinIO).
#R2_ENDPOINT=http://127.0.0.1:9000
# Optional: public base URL (R2 public dev URL or custom domain). When set,
# /api/uploads/<id> 302-redirects there instead of proxying through Vercel.
# Only enable if bucket contents are meant to be public.
#R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# --- Bootstrap admin (required by lib/env.ts, api/admin/login.ts) ---
# Admin email + plaintext password. The password is hashed with bcrypt (cost 12)
# once per warm instance and verified with constant-time comparison.
# Use a strong value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password