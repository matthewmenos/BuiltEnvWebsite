# =============================================================================
# BuiltEnvWebsite — environment template
# Copy to `.env` (api reads it via dotenv) and fill in real values:
#   cp .env.example .env
# Never commit real secrets — `.env`, `.env.local`, `.env.production`
# and `.env.*.local` are git-ignored.
# =============================================================================

# --- Database (required by api/src/database.ts, api/src/env.ts) ---
# Neon Postgres connection string (pooled or direct).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# --- Auth (required by api/src/auth.ts, api/src/env.ts) ---
# Long random secret used to sign admin JWTs (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetime. Accepts jsonwebtoken values like "7d", "24h", "3600".
JWT_EXPIRES_IN=7d

# --- Cloudflare R2 object storage (required by api/src/env.ts) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=builtenv-uploads

# --- Bootstrap admin (required by api/src/env.ts, api/src/api/admin/login/route.ts) ---
# Admin email + plaintext password. The password is hashed with bcrypt (cost 12)
# once at boot and verified with constant-time comparison. Use a strong value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- MVP / local-dev seed data (optional) ---
# Static file list + upload URL placeholder used by api/src/api/admin/files/route.ts.
#R2_FILES=[]
#R2_UPLOAD_URL=https://example.com/uploads

# --- Runtime (optional) ---
# api/src/server.ts uses PORT (default 3000); api/src/env.ts uses NODE_ENV.
PORT=3000
NODE_ENV=development
